{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-land.co.il/schemas/content/real-estate-v1.schema.json",
  "title": "Thailand Platform real-estate content contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "site",
    "hub_route_id",
    "body_contract",
    "rendering_owners",
    "public_labels",
    "freshness_catalog",
    "source_catalog",
    "routes",
    "hub_experience"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "thailand-real-estate-v1"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "hub_route_id": {
      "type": "string",
      "minLength": 1
    },
    "body_contract": {
      "$ref": "#/$defs/body_contract"
    },
    "rendering_owners": {
      "$ref": "#/$defs/rendering_owners"
    },
    "public_labels": {
      "$ref": "#/$defs/public_labels"
    },
    "freshness_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/freshness"
      }
    },
    "source_catalog": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "hub_experience": {
      "$ref": "#/$defs/hub_experience"
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "locale",
        "direction"
      ],
      "properties": {
        "origin": {
          "const": "https://thai-land.co.il"
        },
        "locale": {
          "const": "he-IL"
        },
        "direction": {
          "const": "rtl"
        }
      }
    },
    "body_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mutation_allowed",
        "source_field",
        "wordpress_filter",
        "public_punctuation_policy",
        "prefix_components",
        "suffix_components"
      ],
      "properties": {
        "mode": {
          "const": "preserve_wordpress_body"
        },
        "mutation_allowed": {
          "const": false
        },
        "source_field": {
          "const": "post_content"
        },
        "wordpress_filter": {
          "const": "the_content"
        },
        "public_punctuation_policy": {
          "const": "replace_long_dashes_with_hyphen"
        },
        "prefix_components": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "breadcrumb",
              "route_intro"
            ]
          }
        },
        "suffix_components": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "continuations",
              "freshness",
              "sources"
            ]
          }
        }
      }
    },
    "rendering_owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1",
        "metadata",
        "breadcrumb",
        "schema"
      ],
      "properties": {
        "h1": {
          "const": "content_template"
        },
        "metadata": {
          "const": "yoast_filters"
        },
        "breadcrumb": {
          "const": "content_template_once"
        },
        "schema": {
          "const": "none_in_v1"
        }
      }
    },
    "public_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breadcrumbs_aria",
        "hub_return",
        "continuations_heading",
        "freshness_heading",
        "sources_heading",
        "card_action"
      ],
      "properties": {
        "breadcrumbs_aria": {
          "type": "string",
          "minLength": 2
        },
        "hub_return": {
          "type": "string",
          "minLength": 2
        },
        "continuations_heading": {
          "type": "string",
          "minLength": 2
        },
        "freshness_heading": {
          "type": "string",
          "minLength": 2
        },
        "sources_heading": {
          "type": "string",
          "minLength": 2
        },
        "card_action": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_id",
        "label",
        "detail"
      ],
      "properties": {
        "freshness_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "detail": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "label",
        "url",
        "scope_label"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "scope_label": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "seo_owner_id",
        "kind",
        "path",
        "parent_route_id",
        "wordpress",
        "ownership",
        "public",
        "breadcrumbs",
        "parent_link",
        "continuations",
        "freshness_id",
        "source_ids"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "seo_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "hub",
            "spoke"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#]*/$"
        },
        "parent_route_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "wordpress": {
          "$ref": "#/$defs/wordpress"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "public": {
          "$ref": "#/$defs/public_copy"
        },
        "breadcrumbs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/breadcrumb"
          }
        },
        "parent_link": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/contextual_link"
            }
          ]
        },
        "continuations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/contextual_link"
          }
        },
        "freshness_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "wordpress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_id",
        "post_type",
        "identity_policy",
        "body_mode"
      ],
      "properties": {
        "post_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "post_type": {
          "enum": [
            "page",
            "post"
          ]
        },
        "identity_policy": {
          "enum": [
            "path_exact",
            "id_and_path_exact"
          ]
        },
        "body_mode": {
          "const": "preserve"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_keyword",
        "synonyms",
        "intent"
      ],
      "properties": {
        "primary_keyword": {
          "type": "string",
          "minLength": 3
        },
        "synonyms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "intent": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "public_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1",
        "seo_title",
        "meta_description",
        "summary"
      ],
      "properties": {
        "h1": {
          "type": "string",
          "minLength": 8
        },
        "seo_title": {
          "type": "string",
          "minLength": 8
        },
        "meta_description": {
          "type": "string",
          "minLength": 70,
          "maxLength": 190
        },
        "summary": {
          "type": "string",
          "minLength": 30,
          "maxLength": 300
        }
      }
    },
    "breadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "route_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "route_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "contextual_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_route_id",
        "label",
        "context"
      ],
      "properties": {
        "target_route_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 3
        },
        "context": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "hub_experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_heading",
        "sections",
        "cards",
        "decision_paths"
      ],
      "properties": {
        "section_heading": {
          "type": "string",
          "minLength": 4
        },
        "sections": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/hub_section"
          }
        },
        "cards": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/hub_card"
          }
        },
        "decision_paths": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/decision_path"
          }
        }
      }
    },
    "hub_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "description",
        "route_ids"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "route_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hub_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "eyebrow",
        "title",
        "summary",
        "action_label"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string",
          "minLength": 2
        },
        "title": {
          "type": "string",
          "minLength": 4
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "action_label": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "decision_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "prompt",
        "choices"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "prompt": {
          "type": "string",
          "minLength": 8
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/decision_choice"
          }
        }
      }
    },
    "decision_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "detail",
        "target_route_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 3
        },
        "detail": {
          "type": "string",
          "minLength": 12
        },
        "target_route_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
