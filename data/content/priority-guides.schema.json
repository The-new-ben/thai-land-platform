{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-land.co.il/schemas/content/priority-guides-v1.schema.json",
  "title": "Thailand Platform priority guides contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "site",
    "body_contract",
    "asset_contract",
    "parent_catalog",
    "source_catalog",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "thailand-priority-guides-v1"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "body_contract": {
      "$ref": "#/$defs/body_contract"
    },
    "asset_contract": {
      "$ref": "#/$defs/asset_contract"
    },
    "parent_catalog": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/parent"
      }
    },
    "source_catalog": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "locale", "direction", "name"],
      "properties": {
        "origin": {
          "const": "https://thai-land.co.il"
        },
        "locale": {
          "const": "he-IL"
        },
        "direction": {
          "const": "rtl"
        },
        "name": {
          "const": "Thai-Land.co.il"
        }
      }
    },
    "body_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "content_source",
        "stored_wordpress_body",
        "wordpress_content_filter",
        "public_punctuation_policy"
      ],
      "properties": {
        "mode": {
          "const": "full_replacement"
        },
        "content_source": {
          "const": "compiled_priority_guides_registry"
        },
        "stored_wordpress_body": {
          "const": "untouched"
        },
        "wordpress_content_filter": {
          "const": "not_called"
        },
        "public_punctuation_policy": {
          "const": "replace_long_dashes_with_hyphen"
        }
      }
    },
    "asset_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "filename_pattern",
        "format",
        "widths",
        "allowed_asset_keys",
        "readiness"
      ],
      "properties": {
        "directory": {
          "const": "assets/guides/images"
        },
        "filename_pattern": {
          "const": "{asset_key}-{width}.webp"
        },
        "format": {
          "const": "webp"
        },
        "widths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "allowed_asset_keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "readiness": {
          "const": "all_variants_required"
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "label", "primary_keyword", "path", "availability"],
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "primary_keyword": {
          "type": "string",
          "minLength": 4
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#]*/$|^/$"
        },
        "availability": {
          "enum": ["live", "managed_draft"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "label",
        "publisher",
        "url",
        "scope",
        "checked_on"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 4
        },
        "publisher": {
          "type": "string",
          "minLength": 4
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "scope": {
          "type": "string",
          "minLength": 12
        },
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "kind",
        "seo_owner_id",
        "path",
        "parent_owner_id",
        "wordpress",
        "asset_key",
        "ownership",
        "indexing",
        "freshness",
        "published_on",
        "modified_on",
        "public",
        "breadcrumbs",
        "sections",
        "faqs",
        "related_route_ids",
        "contextual_links",
        "source_ids"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["collection", "guide"]
        },
        "seo_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#]*/$"
        },
        "parent_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "wordpress": {
          "$ref": "#/$defs/wordpress"
        },
        "asset_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "indexing": {
          "$ref": "#/$defs/indexing"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "published_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "modified_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "public": {
          "$ref": "#/$defs/public"
        },
        "breadcrumbs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/breadcrumb"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "faqs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/faq"
          }
        },
        "related_route_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "contextual_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contextual_link"
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "wordpress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "post_type", "identity_policy", "body_mode", "state_policy"],
      "properties": {
        "post_id": {
          "type": "integer"
        },
        "post_type": {
          "enum": ["page", "post"]
        },
        "identity_policy": {
          "const": "id_and_path_exact"
        },
        "body_mode": {
          "const": "full_replacement"
        },
        "state_policy": {
          "enum": ["published_only", "draft_canary_or_published_live"]
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_keyword", "synonyms", "intent"],
      "properties": {
        "primary_keyword": {
          "type": "string",
          "minLength": 4
        },
        "synonyms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "intent": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "follow", "max_image_preview"],
      "properties": {
        "policy": {
          "enum": ["index", "noindex"]
        },
        "follow": {
          "const": true
        },
        "max_image_preview": {
          "const": "large"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_on",
        "next_review_on",
        "review_interval_days",
        "historical",
        "note"
      ],
      "properties": {
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "next_review_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_interval_days": {
          "type": "integer"
        },
        "historical": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kicker",
        "h1",
        "seo_title",
        "meta_description",
        "lede",
        "answer_title",
        "answer",
        "facts"
      ],
      "properties": {
        "kicker": {
          "type": "string",
          "minLength": 3
        },
        "h1": {
          "type": "string",
          "minLength": 8
        },
        "seo_title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 65
        },
        "meta_description": {
          "type": "string",
          "minLength": 90,
          "maxLength": 180
        },
        "lede": {
          "type": "string",
          "minLength": 80,
          "maxLength": 500
        },
        "answer_title": {
          "type": "string",
          "minLength": 4
        },
        "answer": {
          "type": "string",
          "minLength": 80,
          "maxLength": 700
        },
        "facts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2
        },
        "value": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "breadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "availability", "current"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "availability": {
          "enum": ["live", "managed_draft"]
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "heading",
        "paragraphs",
        "bullet_groups",
        "steps",
        "callout"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "heading": {
          "type": "string",
          "minLength": 6
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 40
          }
        },
        "bullet_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet_group"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "callout": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/callout"
            }
          ]
        }
      }
    },
    "bullet_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items"],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 4
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 25
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "title", "text"],
      "properties": {
        "tone": {
          "enum": ["current", "important", "history"]
        },
        "title": {
          "type": "string",
          "minLength": 4
        },
        "text": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 8
        },
        "answer": {
          "type": "string",
          "minLength": 35
        }
      }
    },
    "contextual_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_owner_id",
        "leading_text",
        "anchor_text",
        "trailing_text"
      ],
      "properties": {
        "target_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "leading_text": {
          "type": "string",
          "minLength": 12
        },
        "anchor_text": {
          "type": "string",
          "minLength": 4
        },
        "trailing_text": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}
