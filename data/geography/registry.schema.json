{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thai-land.co.il/data/geography/registry.schema.json",
  "title": "Thailand geography registry authoring contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "dataset_version",
    "country_id",
    "geography_types",
    "classification_schemes",
    "inputs",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "country_id": {
      "const": "geo:th:country"
    },
    "geography_types": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    },
    "classification_schemes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/classification_scheme"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliases",
        "geometry",
        "normalization_vectors",
        "places",
        "provinces",
        "regions",
        "relations"
      ],
      "properties": {
        "aliases": { "$ref": "#/$defs/input" },
        "geometry": { "$ref": "#/$defs/input" },
        "normalization_vectors": { "$ref": "#/$defs/input" },
        "places": { "$ref": "#/$defs/input" },
        "provinces": { "$ref": "#/$defs/input" },
        "regions": { "$ref": "#/$defs/input" },
        "relations": { "$ref": "#/$defs/input" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "classification_scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "is_administrative_parent",
        "levels",
        "source_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["administrative", "editorial", "statistical"] },
        "is_administrative_parent": { "type": "boolean" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_ids"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authority",
        "title",
        "url",
        "published_on",
        "effective_on",
        "retrieved_on",
        "license",
        "covers"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "authority": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "published_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "effective_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "retrieved_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "license": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
